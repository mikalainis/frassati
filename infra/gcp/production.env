# Google Cloud identifiers for the website (not secrets: names and IDs only).
# Filled in from the output of infra/gcp/bootstrap.sh. Read by .github/workflows/deploy.yml;
# until GCP_PROJECT_ID is set, merges to main skip the deploy.
GCP_PROJECT_ID=frassatinj-web
GCP_REGION=us-east4
GCP_WIF_PROVIDER=projects/609724810195/locations/global/workloadIdentityPools/github/providers/github-actions
GCP_DEPLOYER_SA=frassati-deployer@frassatinj-web.iam.gserviceaccount.com
GCP_RUNTIME_SA=frassati-run@frassatinj-web.iam.gserviceaccount.com
